# OrderClarity environment — placeholders only. Never commit real secrets.

# demo | live  (required). Live never falls back to demo.
APP_MODE=demo
PORT=3000

# Shopify app (required for live)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://example.ngrok.io
SCOPES=read_orders,read_products,write_orders
SHOPIFY_API_VERSION=2026-07

# Persistence (required for live)
DATABASE_URL=postgresql://orderclarity:orderclarity@127.0.0.1:5432/orderclarity
REDIS_URL=redis://127.0.0.1:6379

# Application encryption for snapshots and provider payloads (required for live)
ORDERCLARITY_ENCRYPTION_KEY=

# Session secret used by the Shopify React Router scaffold (required for live)
SESSION_SECRET=

# TypeSafe Jev (required for live). Demo uses the deterministic fake.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# Billing
SHOPIFY_TEST_BILLING=true

# Monitoring destination (operator configured)
ORDERCLARITY_ALERT_WEBHOOK=
